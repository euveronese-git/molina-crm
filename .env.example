# Copy to .env.local (local) and Netlify → Environment variables (produção)
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required on Netlify for open CRM (no login) — server reads/writes bypass RLS
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — rota Next /api/webhooks/evolution (payload Evolution cru) — opcional na Netlify
# EVOLUTION_WEBHOOK_SECRET=um-segredo-forte

# Edge Function whatsapp-webhook (chatbot → JSON simplificado) — secrets no painel Supabase
# Project Settings → Edge Functions → Secrets
# ou: npx supabase secrets set WEBHOOK_SECRET="um-segredo-forte" --project-ref <PROJECT_REF>
# URL: https://<PROJECT_REF>.supabase.co/functions/v1/whatsapp-webhook
# WEBHOOK_SECRET=um-segredo-forte
